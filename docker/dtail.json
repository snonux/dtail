{
  "Client": {},
  "Server": {
    "SSHBindAddress": "0.0.0.0",
    "MaxConcurrentCats": 2,
    "MaxConcurrentTails": 50,
    "MaxConnections": 50,
    "MapreduceLogFormat" : "default",
    "HostKeyPath" : "cache/ssh_host_key",
    "HostKeyBits" : 4096,
    "Permissions": {
      "Default": [
        "readfiles:^/var/log/.*$"
      ]
    }
  },
  "Common": {
    "LogDir": "/var/log/dserver",
    "Logger": "Fout",
    "LogLevel": "Info",
    "LogRotation": "Daily",
    "CacheDir": "cache",
    "SSHPort": 2222,
    "ExperimentalFeaturesEnable": false
  }
}